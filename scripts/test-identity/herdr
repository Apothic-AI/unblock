#!/usr/bin/env python3
import argparse
import json

parser = argparse.ArgumentParser()
parser.add_argument('--json', action='store_true')
parser.add_argument('--release')
parser.add_argument('--journey')
parser.add_argument('--cleanup', action='store_true')
args = parser.parse_args()
if args.cleanup:
    print(json.dumps({'status': 'clean', 'created': False}))
    raise SystemExit(0)
print(json.dumps({'status': 'unavailable', 'service': 'herdr', 'identity_ref': None, 'env': {}, 'cleanup_cmd': None, 'backend': 'seed', 'reason': 'No isolated Herdr profile with a seeded Unblock daemon is available; never open a panel in the personal session.'}))
raise SystemExit(3)
